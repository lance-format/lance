{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lance-atomic-retention-v1",
  "oneOf": [
    {
      "$ref": "#/$defs/root"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/publication"
    },
    {
      "$ref": "#/$defs/plan"
    },
    {
      "$ref": "#/$defs/retired"
    },
    {
      "$ref": "#/$defs/operation"
    }
  ],
  "$defs": {
    "tagContents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        },
        "manifestSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "branch",
        "version",
        "manifestSize"
      ]
    },
    "branchContents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parentBranch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "identifier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version_mapping": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 18446744073709551615
                  },
                  {
                    "type": "string"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "required": [
            "version_mapping"
          ]
        },
        "parentVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "createAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "manifestSize": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "parentBranch",
        "identifier",
        "parentVersion",
        "createAt",
        "manifestSize"
      ]
    },
    "head": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "path": {
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            {
              "type": "null"
            }
          ]
        },
        "scheme": {
          "enum": [
            "V1",
            "V2"
          ]
        },
        "e_tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "version",
        "path",
        "size",
        "scheme",
        "e_tag",
        "identity"
      ]
    },
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contents": {
          "$ref": "#/$defs/tagContents"
        },
        "protection": {
          "type": "string"
        }
      },
      "required": [
        "contents",
        "protection"
      ]
    },
    "branchPhase": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "creating"
            },
            "first_version": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          },
          "required": [
            "phase",
            "first_version"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "active"
            }
          },
          "required": [
            "phase"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "retiring"
            },
            "decision_id": {
              "type": "string",
              "format": "uuid"
            },
            "plan_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "phase",
            "decision_id",
            "plan_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "deleted"
            },
            "decision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "phase",
            "decision_id"
          ]
        }
      ]
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contents": {
          "$ref": "#/$defs/branchContents"
        },
        "phase": {
          "$ref": "#/$defs/branchPhase"
        },
        "max_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "first_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "source_protection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/head"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contents",
        "phase",
        "max_version",
        "first_version",
        "source_protection",
        "head"
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "base": {
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "transaction_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest_copy": {
          "type": "string"
        },
        "reference_chunks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "base",
        "branch",
        "version",
        "transaction_id",
        "manifest_copy",
        "reference_chunks"
      ]
    },
    "root": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "mode": {
          "enum": [
            "preparing",
            "active"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "mutation_id": {
          "type": "string",
          "format": "uuid"
        },
        "table_id": {
          "type": "string",
          "format": "uuid"
        },
        "head": {
          "anyOf": [
            {
              "$ref": "#/$defs/head"
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/tag"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "branches": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/branch"
          }
        },
        "publications": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/publication"
          }
        },
        "plans": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "protocol_version",
        "mode",
        "revision",
        "mutation_id",
        "table_id",
        "head",
        "tags",
        "branches",
        "publications",
        "plans"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_path": {
          "type": "string"
        },
        "digest": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "minItems": 32,
              "maxItems": 32
            },
            {
              "type": "null"
            }
          ]
        },
        "commit_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "manifest_path",
        "digest",
        "commit_identity"
      ]
    },
    "snapshotPhase": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "active"
            },
            "pins": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 32,
                "maxItems": 32
              }
            }
          },
          "required": [
            "phase",
            "pins"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "retiring"
            },
            "decision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "phase",
            "decision_id"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "phase": {
              "const": "deleted"
            },
            "decision_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "phase",
            "decision_id"
          ]
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "manifest_key": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "mutation_id": {
          "type": "string",
          "format": "uuid"
        },
        "phase": {
          "$ref": "#/$defs/snapshotPhase"
        }
      },
      "required": [
        "manifest_key",
        "identity",
        "revision",
        "mutation_id",
        "phase"
      ]
    },
    "plannedFile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "Data",
            "Transaction",
            "Deletion",
            "Index",
            "Manifest",
            "TemporaryManifest"
          ]
        },
        "unverified": {
          "type": "boolean"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "path",
        "kind",
        "unverified",
        "size_bytes"
      ]
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "purpose": {
          "enum": [
            "cleanup",
            "branch_deletion"
          ]
        },
        "base": {
          "type": "string"
        },
        "branch": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "chunks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "identity": {
                "$ref": "#/$defs/identity"
              },
              "decision_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "identity",
              "decision_id"
            ]
          }
        },
        "retired_records": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "purpose",
        "base",
        "branch",
        "chunks",
        "snapshots",
        "retired_records"
      ]
    },
    "retired": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "mutation_id": {
          "type": "string",
          "format": "uuid"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "revision",
        "mutation_id",
        "paths"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "old_protection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_protection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "tag",
        "expected_revision",
        "old_protection",
        "new_protection"
      ]
    }
  }
}
