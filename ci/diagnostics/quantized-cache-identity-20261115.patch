+/// Diagnostic-only: canonical bits of the query vector that the base identity
+/// binds. Only used by the identity print above; never part of the API.
+fn diagnostic_query_key_bits(query: &Query) -> String {
+    match query.key.data_type() {
+        DataType::Float16 => query
+            .key
+            .as_primitive::<arrow_array::types::Float16Type>()
+            .values()
+            .iter()
+            .map(|value| format!("{:04x}", value.to_bits()))
+            .collect::<Vec<_>>()
+            .join(","),
+        DataType::Float32 => query
+            .key
+            .as_primitive::<arrow_array::types::Float32Type>()
+            .values()
+            .iter()
+            .map(|value| format!("{:08x}", value.to_bits()))
+            .collect::<Vec<_>>()
+            .join(","),
+        DataType::Float64 => query
+            .key
+            .as_primitive::<arrow_array::types::Float64Type>()
+            .values()
+            .iter()
+            .map(|value| format!("{:016x}", value.to_bits()))
+            .collect::<Vec<_>>()
+            .join(","),
+        other => format!("<unsupported:{other:?}>"),
+    }
+}
