+// Diagnostic-only residency view. Units follow the cache diagnostics contract:
+// capacity/size values are accounted weighted bytes (key footprint + declared
+// entry size), and num_entries is the resident entry count, not a count of
+// logical keys. Aggregate occupancy cannot prove that one specific key is
+// resident; the scan path prints a non-counting per-key peek for that.
+async fn refinement_cache_residency(dataset: &Dataset) -> String {
+    let diagnostics = dataset
+        .index_cache
+        .diagnostics_by_type(CacheSnapshotMode::Refreshed)
+        .await;
+    let backend = diagnostics.backend;
+    let qrf = diagnostics
+        .by_type
+        .as_ref()
+        .and_then(|by_type| by_type.occupancy.as_ref())
+        .and_then(|occupancy| {
+            occupancy
+                .types
+                .iter()
+                .find(|entry| entry.type_name == "QuantizedRefinementResult")
+        });
+    match qrf {
+        Some(qrf) => format!(
+            "capacity_bytes={:?} backend_num_entries={:?} backend_size_bytes={:?} \
+             backend_write_attempts={:?} backend_size_removals={:?} \
+             qrf_num_entries={} qrf_size_bytes={}",
+            backend.capacity_bytes,
+            backend.num_entries,
+            backend.size_bytes,
+            backend.write_attempts,
+            backend.size_removals,
+            qrf.num_entries,
+            qrf.size_bytes,
+        ),
+        None => format!(
+            "capacity_bytes={:?} backend_num_entries={:?} backend_size_bytes={:?} \
+             backend_write_attempts={:?} backend_size_removals={:?} \
+             qrf_num_entries=<absent> qrf_size_bytes=<absent>",
+            backend.capacity_bytes,
+            backend.num_entries,
+            backend.size_bytes,
+            backend.write_attempts,
+            backend.size_removals,
+        ),
+    }
+}
